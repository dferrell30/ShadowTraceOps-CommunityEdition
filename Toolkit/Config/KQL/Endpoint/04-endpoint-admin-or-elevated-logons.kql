// Shadow Trace Ops - Possible admin/elevated endpoint logons
// Purpose: Review local admin or elevated logon context where available.
// Note: IsLocalAdmin may not exist in every tenant/schema; column_ifexists keeps this query safer.
let TargetUser = "{TargetUser}";
DeviceLogonEvents
| where Timestamp > ago(30d)
| extend AccountUpnSafe = tostring(column_ifexists("AccountUpn", "")),
         AccountNameSafe = tostring(column_ifexists("AccountName", "")),
         DeviceNameSafe = tostring(column_ifexists("DeviceName", "")),
         IsLocalAdminSafe = tostring(column_ifexists("IsLocalAdmin", "")),
         LogonTypeSafe = tostring(column_ifexists("LogonType", "")),
         ActionTypeSafe = tostring(column_ifexists("ActionType", ""))
| where AccountUpnSafe =~ TargetUser or AccountNameSafe =~ split(TargetUser, "@")[0]
| where IsLocalAdminSafe =~ "true" or AccountNameSafe has_any ("admin", "administrator")
| project Timestamp, DeviceName=DeviceNameSafe, AccountUpn=AccountUpnSafe, AccountName=AccountNameSafe, IsLocalAdmin=IsLocalAdminSafe, LogonType=LogonTypeSafe, ActionType=ActionTypeSafe
| order by Timestamp desc
