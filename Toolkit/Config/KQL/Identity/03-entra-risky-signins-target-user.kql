// Shadow Trace Ops - Risky Entra sign-ins for target user
let TargetUser = "{TargetUser}";
EntraIdSignInEvents
| where Timestamp > ago(30d)
| extend AccountUpnSafe = tostring(column_ifexists("AccountUpn", "")),
         UserPrincipalNameSafe = tostring(column_ifexists("UserPrincipalName", "")),
         Account = iff(isnotempty(AccountUpnSafe), AccountUpnSafe, UserPrincipalNameSafe),
         RiskLevelSafe = tostring(column_ifexists("RiskLevel", column_ifexists("RiskLevelAggregated", ""))),
         RiskStateSafe = tostring(column_ifexists("RiskState", "")),
         RiskDetailSafe = tostring(column_ifexists("RiskDetail", "")),
         ApplicationSafe = tostring(column_ifexists("Application", column_ifexists("AppDisplayName", ""))),
         IPAddressSafe = tostring(column_ifexists("IPAddress", "")),
         CountrySafe = tostring(column_ifexists("Country", column_ifexists("Location", "")))
| where Account =~ TargetUser
| where RiskLevelSafe !in ("", "none", "hidden", "low") or RiskStateSafe !in ("", "none")
| project Timestamp, Account, Application=ApplicationSafe, IPAddress=IPAddressSafe, Country=CountrySafe, RiskLevel=RiskLevelSafe, RiskState=RiskStateSafe, RiskDetail=RiskDetailSafe
| order by Timestamp desc
